APP_NAME=FinanceAI Trading Platform
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys
NEWS_API_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Finnhub — real-time US stock quotes (free, 60 calls/min)
# Sign up at https://finnhub.io → Dashboard → API Key (copy the key shown)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca — optional additional US stock source (free account at alpaca.markets)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# Trading Settings
PAPER_TRADING=true
INITIAL_BALANCE=100000.0
MAX_POSITION_SIZE=0.10
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
MAX_DAILY_LOSS_PCT=0.02

# AI Settings
SENTIMENT_WEIGHT=0.30
TECHNICAL_WEIGHT=0.40
PREDICTION_WEIGHT=0.30
MIN_CONFIDENCE_THRESHOLD=0.65
