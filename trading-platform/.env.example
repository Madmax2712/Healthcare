# FinanceAI Trading Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it contains secrets)

# ── Security ──────────────────────────────────────────────────────────────────
# Change this to a long random string in production
# Generate one at: https://randomkeygen.com/
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# ── Trading Settings ──────────────────────────────────────────────────────────
PAPER_TRADING=true          # Keep as "true" — this uses fake money, no real trades
INITIAL_BALANCE=100000.0    # Starting balance in USD (paper money)
MAX_POSITION_SIZE=0.10      # Max 10% of portfolio in one trade
STOP_LOSS_PCT=0.05          # Auto-sell if position drops 5%
TAKE_PROFIT_PCT=0.15        # Auto-sell when position gains 15%

# ── Optional API Keys (leave blank if you don't have them) ────────────────────
# Get a free key at https://newsapi.org (500 requests/day free)
NEWS_API_KEY=

# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=FinanceAI Trading Platform
